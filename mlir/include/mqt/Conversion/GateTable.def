/**
 * @file GateTable.def
 * @brief Central gate registry for QC, QCO, and QIR conversions.
 *
 * Define
 * `MQT_GATE(KEY, NAME, GETTER, TARGETS, PARAMS, SUFFIX, CTL_SUFFIX)` before
 * including this file. `KEY` names the MLIR QC/QCO operation, `NAME` is the QIR
 * symbol stem, `GETTER` identifies the QIR function-name selector, `TARGETS`
 * and `PARAMS` describe the body signature, and `SUFFIX`/`CTL_SUFFIX` select
 * the uncontrolled and controlled QIR specializations.
 */

#ifndef MQT_GATE
#define MQT_GATE(KEY, NAME, GETTER, TARGETS, PARAMS, SUFFIX, CTL_SUFFIX)
#endif

MQT_GATE(Id, i, I, 1, 0, body, ctl)
MQT_GATE(X, x, X, 1, 0, body, ctl)
MQT_GATE(Y, y, Y, 1, 0, body, ctl)
MQT_GATE(Z, z, Z, 1, 0, body, ctl)
MQT_GATE(H, h, H, 1, 0, body, ctl)
MQT_GATE(S, s, S, 1, 0, body, ctl)
MQT_GATE(Sdg, s, SDG, 1, 0, adj, ctladj)
MQT_GATE(T, t, T, 1, 0, body, ctl)
MQT_GATE(Tdg, t, TDG, 1, 0, adj, ctladj)
MQT_GATE(SX, sx, SX, 1, 0, body, ctl)
MQT_GATE(SXdg, sx, SXDG, 1, 0, adj, ctladj)
MQT_GATE(RX, rx, RX, 1, 1, body, ctl)
MQT_GATE(RY, ry, RY, 1, 1, body, ctl)
MQT_GATE(RZ, rz, RZ, 1, 1, body, ctl)
MQT_GATE(P, p, P, 1, 1, body, ctl)
MQT_GATE(R, prx, R, 1, 2, body, ctl)
MQT_GATE(U2, u2, U2, 1, 2, body, ctl)
MQT_GATE(U, u3, U, 1, 3, body, ctl)
MQT_GATE(SWAP, swap, SWAP, 2, 0, body, ctl)
MQT_GATE(iSWAP, iswap, ISWAP, 2, 0, body, ctl)
MQT_GATE(DCX, dcx, DCX, 2, 0, body, ctl)
MQT_GATE(ECR, ecr, ECR, 2, 0, body, ctl)
MQT_GATE(RXX, rxx, RXX, 2, 1, body, ctl)
MQT_GATE(RYY, ryy, RYY, 2, 1, body, ctl)
MQT_GATE(RZX, rzx, RZX, 2, 1, body, ctl)
MQT_GATE(RZZ, rzz, RZZ, 2, 1, body, ctl)
MQT_GATE(XXPlusYY, xx_plus_yy, XXPLUSYY, 2, 2, body, ctl)
MQT_GATE(XXMinusYY, xx_minus_yy, XXMINUSYY, 2, 2, body, ctl)
MQT_GATE(RCCX, rccx, RCCX, 3, 0, body, ctl)

#undef MQT_GATE
