--- a/src/common/node_conf.h
+++ b/src/common/node_conf.h
@@ -153,6 +153,7 @@
 					 * use for scheduling purposes */
 	list_t *gres_list;		/* list of gres state info managed by
 					 * plugins */
+	bool hres_registered;		/* Per-controller registration, not saved */
 	uint32_t index;			/* Index into node_record_table_ptr */
 	char *instance_id;		/* cloud instance id */
 	char *instance_type;		/* cloud instance type */
--- a/src/slurmctld/node_mgr.c
+++ b/src/slurmctld/node_mgr.c
@@ -3672,6 +3672,37 @@
 	if (node_ptr == NULL)
 		return ENOENT;

+	/* Restore dynamic membership once after controller reexec/state recovery. */
+	if (IS_NODE_DYNAMIC_NORM(node_ptr) && !node_ptr->hres_registered &&
+	    reg_msg->dynamic_conf) {
+		s_p_hashtbl_t *node_hashtbl = NULL;
+		slurm_conf_node_t *conf_node;
+		list_t *hres_info = NULL;
+		int rc = SLURM_ERROR;
+
+		conf_node = slurm_conf_parse_nodeline(reg_msg->dynamic_conf,
+						    &node_hashtbl);
+		if (conf_node) {
+			rc = SLURM_SUCCESS;
+			if (conf_node->hres_str)
+				rc = SERCLI_PARSE_STR(NODE_HRES_INFO_LIST, NULL,
+						      hres_info, conf_node->hres_str,
+						      strlen(conf_node->hres_str),
+						      MIME_TYPE_JSON);
+			if (!rc && hres_info)
+				rc = hres_add_nodes(hres_info, node_ptr->name, NULL);
+		}
+		FREE_NULL_LIST(hres_info);
+		s_p_hashtbl_destroy(node_hashtbl);
+		if (rc) {
+			error("%s: Unable to restore dynamic HRES for node %s",
+			      __func__, node_ptr->name);
+			return SLURM_ERROR;
+		}
+		/* Later registrations must preserve administrator HRES updates. */
+		node_ptr->hres_registered = true;
+	}
+
 	debug3("%s: validating nodes %s in state: %s",
 	       __func__, reg_msg->node_name,
 	       node_state_string(node_ptr->node_state));
