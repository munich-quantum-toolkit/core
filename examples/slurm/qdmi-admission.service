[Unit]
Description=Initialize QDMI license admission
Requires=slurmctld.service
PartOf=slurmctld.service
After=slurmctld.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/mqt-qdmi-admission
RemainAfterExit=yes
Restart=on-failure
RestartSec=2
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
