[Unit]
Description=Prepare the MQT Core Slurm test node
RequiresMountsFor=/runtime
Before=munge.service slurmctld.service slurmd.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/mqt-slurm-prepare
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
