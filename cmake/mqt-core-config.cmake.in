# A CMake config file for the library, to be used by external projects

@PACKAGE_INIT@

set(mqt-core_FOUND TRUE)
set(mqt-core_Runtime_FOUND TRUE)
set(mqt-core_Development_FOUND FALSE)
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/mqt-core-development-targets.cmake")
  set(mqt-core_Development_FOUND TRUE)
elseif(mqt-core_FIND_REQUIRED_Development)
  set(mqt-core_NOT_FOUND_MESSAGE
      "The Development component requires an MQT Core source installation.")
endif()
check_required_components(mqt-core)
if(NOT mqt-core_FOUND)
  return()
endif()

include(CMakeFindDependencyMacro)
find_dependency(qdmi)
include("${CMAKE_CURRENT_LIST_DIR}/AddMQTQDMIDevice.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/mqt-core-runtime-targets.cmake")
if(mqt-core_Development_FOUND AND (NOT mqt-core_FIND_COMPONENTS OR "Development" IN_LIST
                                                                   mqt-core_FIND_COMPONENTS))
  find_package(LLVM @LLVM_VERSION_MAJOR@.@LLVM_VERSION_MINOR@ CONFIG QUIET)
  if(LLVM_FOUND)
    include("${CMAKE_CURRENT_LIST_DIR}/mqt-core-development-targets.cmake")
    target_include_directories(MQT::CoreSupport SYSTEM INTERFACE ${LLVM_INCLUDE_DIRS})
  else()
    set(mqt-core_Development_FOUND FALSE)
    set(mqt-core_NOT_FOUND_MESSAGE
        "The Development component requires an LLVM @LLVM_VERSION_MAJOR@.@LLVM_VERSION_MINOR@ SDK.")
    if(NOT mqt-core_FIND_COMPONENTS)
      set(mqt-core_FOUND FALSE)
    endif()
  endif()
endif()
check_required_components(mqt-core)

if(mqt-core_FOUND AND NOT mqt-core_FIND_QUIETLY)
  message(STATUS "Found mqt-core version ${mqt-core_VERSION}")
endif()
