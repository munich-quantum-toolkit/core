# Native C++ reference. Keep intentional settings; use doxygen -x to review changes.
PROJECT_NAME           = "MQT Core"
PROJECT_BRIEF          = "The Backbone of the Munich Quantum Toolkit (MQT)"
OUTPUT_DIRECTORY       = _build/doxygen
STRIP_FROM_PATH        = ../include/mqt-core \
                         ../src \
                         ..
TOC_INCLUDE_HEADINGS   = 0
BUILTIN_STL_SUPPORT    = YES
TYPEDEF_HIDES_STRUCT   = YES
EXTRACT_ALL            = YES
SHOW_INCLUDE_FILES     = NO
SORT_MEMBER_DOCS       = NO
GENERATE_TODOLIST      = NO
GENERATE_TESTLIST      = NO
GENERATE_BUGLIST       = NO
GENERATE_DEPRECATEDLIST= NO
SHOW_USED_FILES        = NO
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = YES
INPUT                  = ../include/mqt-core \
                         ../doxygen/mainpage.md \
                         ../doxygen/namespaces.md
FILE_PATTERNS          = *.hpp *.h *.inc *.md
RECURSIVE              = YES
EXCLUDE_SYMBOLS        = std
IMAGE_PATH             = _static
USE_MDFILE_AS_MAINPAGE = ../doxygen/mainpage.md
VERBATIM_HEADERS       = NO
HTML_HEADER            = _templates/doxygen-header.html
HTML_EXTRA_STYLESHEET  = _static/mqt-doxygen.css
HTML_EXTRA_FILES       = _static/cpp-api-navigation.js \
                         _static/mqt_light.png \
                         _static/mqt_dark.png
HTML_COLORSTYLE        = TOGGLE
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
GENERATE_LATEX         = NO
LATEX_BIB_STYLE        = plain
GENERATE_XML           = YES
XML_PROGRAMLISTING     = NO
MACRO_EXPANSION        = YES
INCLUDE_PATH           = ../include/mqt-core

GENERATE_TAGFILE       = _build/doxygen/mqt-core.tag
EXTERNAL_GROUPS        = NO
EXTERNAL_PAGES         = NO

WARN_AS_ERROR = FAIL_ON_WARNINGS
HAVE_DOT = NO
# Static menus generate valid member-index anchors in Doxygen 1.17/1.18.
HTML_DYNAMIC_MENUS = NO
DISABLE_INDEX = NO
GENERATE_TREEVIEW = YES
